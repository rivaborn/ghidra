ps1C: is BITS_6_10=26 { export ps1_f26; }
ps1C: is BITS_6_10=27 { export ps1_f27; }
ps1C: is BITS_6_10=28 { export ps1_f28; }
ps1C: is BITS_6_10=29 { export ps1_f29; }
ps1C: is BITS_6_10=30 { export ps1_f30; }
ps1C: is BITS_6_10=31 { export ps1_f31; }

@define GEKKO_PS1_D "& ps1D"
@define GEKKO_PS1_FILL "ps1D = fD;"

define pcodeop psqDequantize;    # (ea, GQR) -> element as double
define pcodeop psqQuantize;      # (ea, GQR, value): stores one element
define pcodeop dataCacheBlockClearToZeroLocked;

# Quantization register selected by I (D-form bits 12..14, indexed form bits 7..9)
psqGQRd: spr390 is (BITS_12_15=0 | BITS_12_15=8) & spr390 { export spr390; }
psqGQRd: spr391 is (BITS_12_15=1 | BITS_12_15=9) & spr391 { export spr391; }
psqGQRd: spr392 is (BITS_12_15=2 | BITS_12_15=10) & spr392 { export spr392; }
psqGQRd: spr393 is (BITS_12_15=3 | BITS_12_15=11) & spr393 { export spr393; }
psqGQRd: spr394 is (BITS_12_15=4 | BITS_12_15=12) & spr394 { export spr394; }
psqGQRd: spr395 is (BITS_12_15=5 | BITS_12_15=13) & spr395 { export spr395; }
psqGQRd: spr396 is (BITS_12_15=6 | BITS_12_15=14) & spr396 { export spr396; }
psqGQRd: spr397 is (BITS_12_15=7 | BITS_12_15=15) & spr397 { export spr397; }
psqGQRx: spr390 is (BITS_21_24=0 | BITS_21_24=8) & spr390 { export spr390; }
psqGQRx: spr391 is (BITS_21_24=1 | BITS_21_24=9) & spr391 { export spr391; }
psqGQRx: spr392 is (BITS_21_24=2 | BITS_21_24=10) & spr392 { export spr392; }
psqGQRx: spr393 is (BITS_21_24=3 | BITS_21_24=11) & spr393 { export spr393; }
psqGQRx: spr394 is (BITS_21_24=4 | BITS_21_24=12) & spr394 { export spr394; }
psqGQRx: spr395 is (BITS_21_24=5 | BITS_21_24=13) & spr395 { export spr395; }
psqGQRx: spr396 is (BITS_21_24=6 | BITS_21_24=14) & spr396 { export spr396; }
psqGQRx: spr397 is (BITS_21_24=7 | BITS_21_24=15) & spr397 { export spr397; }

# 12-bit signed displacement of the D-form quantized loads and stores
psqAddr:  psqd(RA_OR_ZERO) is SIMM & RA_OR_ZERO [ psqd = ((SIMM & 0xfff) ^ 0x800) - 0x800; ]
{ tmp:$(REGISTER_SIZE) = RA_OR_ZERO + psqd; export tmp; }
psqAddrU: psqd(A)          is SIMM & A          [ psqd = ((SIMM & 0xfff) ^ 0x800) - 0x800; ]
{ tmp:$(REGISTER_SIZE) = A + psqd; export tmp; }

# Record (Rc=1) forms copy the FPSCR summary bits into cr1
PSRC: is Rc=0 { }
PSRC: "." is Rc=1 { cr1flags(); }

macro psRound(dst, v) {
	local single:4 = float2float(v);
	dst = float2float(single);
}

################################################################
# Quantized loads and stores
################################################################

:psq_l fD,psqAddr,"0",psqGQRd is OP=56 & fD & ps1D & psqAddr & BIT_15=0 & psqGQRd
{
	local ea:$(REGISTER_SIZE) = psqAddr;
	local gqr:4 = psqGQRd;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	ps1D = float2float(*:4 (ea + 4));
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local esize:$(REGISTER_SIZE) = (ltype & 1) + 1;
	ps1D = psqDequantize(ea + esize, gqr);
<done>
}

:psq_lu fD,psqAddrU,"0",psqGQRd is OP=57 & fD & ps1D & psqAddrU & BIT_15=0 & psqGQRd & A
{
	local ea:$(REGISTER_SIZE) = psqAddrU;
	local gqr:4 = psqGQRd;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	ps1D = float2float(*:4 (ea + 4));
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local esize:$(REGISTER_SIZE) = (ltype & 1) + 1;
	ps1D = psqDequantize(ea + esize, gqr);
<done>
	A = ea;
}

:psq_st fS,psqAddr,"0",psqGQRd is OP=60 & fS & ps1D & psqAddr & BIT_15=0 & psqGQRd
{
	local ea:$(REGISTER_SIZE) = psqAddr;
	local gqr:4 = psqGQRd;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	*:4 (ea + 4) = float2float(ps1D);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
	local esize:$(REGISTER_SIZE) = (stype & 1) + 1;
	psqQuantize(ea + esize, gqr, ps1D);
<done>
}

:psq_stu fS,psqAddrU,"0",psqGQRd is OP=61 & fS & ps1D & psqAddrU & BIT_15=0 & psqGQRd & A
{
	local ea:$(REGISTER_SIZE) = psqAddrU;
	local gqr:4 = psqGQRd;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	*:4 (ea + 4) = float2float(ps1D);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
	local esize:$(REGISTER_SIZE) = (stype & 1) + 1;
	psqQuantize(ea + esize, gqr, ps1D);
<done>
	A = ea;
}

:psq_lx fD,RA_OR_ZERO,B,"0",psqGQRx is OP=4 & fD & ps1D & RA_OR_ZERO & B & BIT_10=0 & psqGQRx & BIT_6=0 & XOP_1_5=6 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local gqr:4 = psqGQRx;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	ps1D = float2float(*:4 (ea + 4));
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local esize:$(REGISTER_SIZE) = (ltype & 1) + 1;
	ps1D = psqDequantize(ea + esize, gqr);
<done>
}

:psq_lux fD,A,B,"0",psqGQRx is OP=4 & fD & ps1D & A & B & BIT_10=0 & psqGQRx & BIT_6=1 & XOP_1_5=6 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = A + B;
	local gqr:4 = psqGQRx;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	ps1D = float2float(*:4 (ea + 4));
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local esize:$(REGISTER_SIZE) = (ltype & 1) + 1;
	ps1D = psqDequantize(ea + esize, gqr);
<done>
	A = ea;
}

:psq_stx fS,RA_OR_ZERO,B,"0",psqGQRx is OP=4 & fS & ps1D & RA_OR_ZERO & B & BIT_10=0 & psqGQRx & BIT_6=0 & XOP_1_5=7 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local gqr:4 = psqGQRx;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	*:4 (ea + 4) = float2float(ps1D);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
	local esize:$(REGISTER_SIZE) = (stype & 1) + 1;
	psqQuantize(ea + esize, gqr, ps1D);
<done>
}

:psq_stux fS,A,B,"0",psqGQRx is OP=4 & fS & ps1D & A & B & BIT_10=0 & psqGQRx & BIT_6=1 & XOP_1_5=7 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = A + B;
	local gqr:4 = psqGQRx;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	*:4 (ea + 4) = float2float(ps1D);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
	local esize:$(REGISTER_SIZE) = (stype & 1) + 1;
	psqQuantize(ea + esize, gqr, ps1D);
<done>
	A = ea;
}

:psq_l fD,psqAddr,"1",psqGQRd is OP=56 & fD & ps1D & psqAddr & BIT_15=1 & psqGQRd
{
	local ea:$(REGISTER_SIZE) = psqAddr;
	local gqr:4 = psqGQRd;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	local one:4 = 1;
	ps1D = int2float(one);
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local one2:4 = 1;
	ps1D = int2float(one2);
<done>
}

:psq_lu fD,psqAddrU,"1",psqGQRd is OP=57 & fD & ps1D & psqAddrU & BIT_15=1 & psqGQRd & A
{
	local ea:$(REGISTER_SIZE) = psqAddrU;
	local gqr:4 = psqGQRd;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	local one:4 = 1;
	ps1D = int2float(one);
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local one2:4 = 1;
	ps1D = int2float(one2);
<done>
	A = ea;
}

:psq_st fS,psqAddr,"1",psqGQRd is OP=60 & fS & ps1D & psqAddr & BIT_15=1 & psqGQRd
{
	local ea:$(REGISTER_SIZE) = psqAddr;
	local gqr:4 = psqGQRd;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
<done>
}

:psq_stu fS,psqAddrU,"1",psqGQRd is OP=61 & fS & ps1D & psqAddrU & BIT_15=1 & psqGQRd & A
{
	local ea:$(REGISTER_SIZE) = psqAddrU;
	local gqr:4 = psqGQRd;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
<done>
	A = ea;
}

:psq_lx fD,RA_OR_ZERO,B,"1",psqGQRx is OP=4 & fD & ps1D & RA_OR_ZERO & B & BIT_10=1 & psqGQRx & BIT_6=0 & XOP_1_5=6 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local gqr:4 = psqGQRx;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	local one:4 = 1;
	ps1D = int2float(one);
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local one2:4 = 1;
	ps1D = int2float(one2);
<done>
}

:psq_lux fD,A,B,"1",psqGQRx is OP=4 & fD & ps1D & A & B & BIT_10=1 & psqGQRx & BIT_6=1 & XOP_1_5=6 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = A + B;
	local gqr:4 = psqGQRx;
	local ltype:4 = (gqr >> 16) & 7;
	if (ltype != 0) goto <dequantize>;
	fD = float2float(*:4 ea);
	local one:4 = 1;
	ps1D = int2float(one);
	goto <done>;
<dequantize>
	fD = psqDequantize(ea, gqr);
	local one2:4 = 1;
	ps1D = int2float(one2);
<done>
	A = ea;
}

:psq_stx fS,RA_OR_ZERO,B,"1",psqGQRx is OP=4 & fS & ps1D & RA_OR_ZERO & B & BIT_10=1 & psqGQRx & BIT_6=0 & XOP_1_5=7 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	local gqr:4 = psqGQRx;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
<done>
}

:psq_stux fS,A,B,"1",psqGQRx is OP=4 & fS & ps1D & A & B & BIT_10=1 & psqGQRx & BIT_6=1 & XOP_1_5=7 & BIT_0=0
{
	local ea:$(REGISTER_SIZE) = A + B;
	local gqr:4 = psqGQRx;
	local stype:4 = gqr & 7;
	if (stype != 0) goto <quantize>;
	*:4 ea = float2float(fS);
	goto <done>;
<quantize>
	psqQuantize(ea, gqr, fS);
<done>
	A = ea;
}

################################################################
# Paired-single arithmetic (A-form, primary opcode 4)
################################################################

:ps_div^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & BITS_6_10=0 & XOP_1_5=18 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	psRound(fD, a0 f/ b0);
	psRound(ps1D, a1 f/ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_sub^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & BITS_6_10=0 & XOP_1_5=20 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	psRound(fD, a0 f- b0);
	psRound(ps1D, a1 f- b1);
	setFPRF(fD);
	build PSRC;
}

:ps_add^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & BITS_6_10=0 & XOP_1_5=21 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	psRound(fD, a0 f+ b0);
	psRound(ps1D, a1 f+ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_res^PSRC fD,fB is OP=4 & fD & ps1D & fB & ps1B & BITS_16_20=0 & BITS_6_10=0 & XOP_1_5=24 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	local onei:4 = 1;
	local one:8 = int2float(onei);
	psRound(fD, one f/ b0);
	psRound(ps1D, one f/ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_mul^PSRC fD,fA,fC is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & BITS_11_15=0 & XOP_1_5=25 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local c0:8 = fC;
	local c1:8 = ps1C;
	psRound(fD, a0 f* c0);
	psRound(ps1D, a1 f* c1);
	setFPRF(fD);
	build PSRC;
}

:ps_rsqrte^PSRC fD,fB is OP=4 & fD & ps1D & fB & ps1B & BITS_16_20=0 & BITS_6_10=0 & XOP_1_5=26 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	local onei:4 = 1;
	local one:8 = int2float(onei);
	psRound(fD, one f/ sqrt(b0));
	psRound(ps1D, one f/ sqrt(b1));
	setFPRF(fD);
	build PSRC;
}

:ps_msub^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=28 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	local c1:8 = ps1C;
	psRound(fD, (a0 f* c0) f- b0);
	psRound(ps1D, (a1 f* c1) f- b1);
	setFPRF(fD);
	build PSRC;
}

:ps_madd^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=29 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	local c1:8 = ps1C;
	psRound(fD, (a0 f* c0) f+ b0);
	psRound(ps1D, (a1 f* c1) f+ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_nmsub^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=30 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	local c1:8 = ps1C;
	psRound(fD, f- ((a0 f* c0) f- b0));
	psRound(ps1D, f- ((a1 f* c1) f- b1));
	setFPRF(fD);
	build PSRC;
}

:ps_nmadd^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=31 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	local c1:8 = ps1C;
	psRound(fD, f- ((a0 f* c0) f+ b0));
	psRound(ps1D, f- ((a1 f* c1) f+ b1));
	setFPRF(fD);
	build PSRC;
}

:ps_sum0^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=10 & PSRC
{
	local a0:8 = fA;
	local b1:8 = ps1B;
	local c1:8 = ps1C;
	psRound(fD, a0 f+ b1);
	psRound(ps1D, c1);
	setFPRF(fD);
	build PSRC;
}

:ps_sum1^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=11 & PSRC
{
	local a0:8 = fA;
	local b1:8 = ps1B;
	local c0:8 = fC;
	psRound(fD, c0);
	psRound(ps1D, a0 f+ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_muls0^PSRC fD,fA,fC is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & BITS_11_15=0 & XOP_1_5=12 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local c0:8 = fC;
	psRound(fD, a0 f* c0);
	psRound(ps1D, a1 f* c0);
	setFPRF(fD);
	build PSRC;
}

:ps_muls1^PSRC fD,fA,fC is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & BITS_11_15=0 & XOP_1_5=13 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local c1:8 = ps1C;
	psRound(fD, a0 f* c1);
	psRound(ps1D, a1 f* c1);
	setFPRF(fD);
	build PSRC;
}

:ps_madds0^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=14 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	psRound(fD, (a0 f* c0) f+ b0);
	psRound(ps1D, (a1 f* c0) f+ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_madds1^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=15 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c1:8 = ps1C;
	psRound(fD, (a0 f* c1) f+ b0);
	psRound(ps1D, (a1 f* c1) f+ b1);
	setFPRF(fD);
	build PSRC;
}

:ps_sel^PSRC fD,fA,fC,fB is OP=4 & fD & ps1D & fA & ps1A & fC & ps1C & fB & ps1B & XOP_1_5=23 & PSRC
{
	local a0:8 = fA;
	local a1:8 = ps1A;
	local b0:8 = fB;
	local b1:8 = ps1B;
	local c0:8 = fC;
	local c1:8 = ps1C;
	local zeroi:4 = 0;
	local zero:8 = int2float(zeroi);
	fD = c0;
	if (a0 f>= zero) goto <sel1>;
	fD = b0;
<sel1>
	ps1D = c1;
	if (a1 f>= zero) goto <sel2>;
	ps1D = b1;
<sel2>
	build PSRC;
}

################################################################
# Moves, sign operations, merges (X-form)
################################################################

:ps_neg^PSRC fD,fB is OP=4 & fD & ps1D & BITS_16_20=0 & fB & ps1B & XOP_1_10=40 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	fD = f- b0;
	ps1D = f- b1;
	build PSRC;
}

:ps_mr^PSRC fD,fB is OP=4 & fD & ps1D & BITS_16_20=0 & fB & ps1B & XOP_1_10=72 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	fD = b0;
	ps1D = b1;
	build PSRC;
}

:ps_nabs^PSRC fD,fB is OP=4 & fD & ps1D & BITS_16_20=0 & fB & ps1B & XOP_1_10=136 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	fD = f- abs(b0);
	ps1D = f- abs(b1);
	build PSRC;
}

:ps_abs^PSRC fD,fB is OP=4 & fD & ps1D & BITS_16_20=0 & fB & ps1B & XOP_1_10=264 & PSRC
{
	local b0:8 = fB;
	local b1:8 = ps1B;
	fD = abs(b0);
	ps1D = abs(b1);
	build PSRC;
}

:ps_merge00^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & XOP_1_10=528 & PSRC
{
	local hi:8 = fA;
	local lo:8 = fB;
	fD = hi;
	ps1D = lo;
	build PSRC;
}

:ps_merge01^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & XOP_1_10=560 & PSRC
{
	local hi:8 = fA;
	local lo:8 = ps1B;
	fD = hi;
	ps1D = lo;
	build PSRC;
}

:ps_merge10^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & XOP_1_10=592 & PSRC
{
	local hi:8 = ps1A;
	local lo:8 = fB;
	fD = hi;
	ps1D = lo;
	build PSRC;
}

:ps_merge11^PSRC fD,fA,fB is OP=4 & fD & ps1D & fA & ps1A & fB & ps1B & XOP_1_10=624 & PSRC
{
	local hi:8 = ps1A;
	local lo:8 = ps1B;
	fD = hi;
	ps1D = lo;
	build PSRC;
}

################################################################
# Compares (ps0 or ps1 halves, like fcmpu / fcmpo)
################################################################

:ps_cmpu0 CRFD,fA,fB is OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=0 & BIT_0=0
{
	local a:8 = fA;
	local b:8 = fB;
	local un:1 = nan(a) | nan(b);
	fp_cc0 = a f< b;
	fp_cc1 = a f> b;
	fp_cc2 = a f== b;
	fp_cc3 = un;
	CRFD = (fp_cc0 << 3) | (fp_cc1 << 2) | (fp_cc2 << 1) | un;
}

:ps_cmpo0 CRFD,fA,fB is OP=4 & CRFD & BITS_21_22=0 & fA & fB & XOP_1_10=32 & BIT_0=0
{
	local a:8 = fA;
	local b:8 = fB;
	local un:1 = nan(a) | nan(b);
	fp_cc0 = a f< b;
	fp_cc1 = a f> b;
	fp_cc2 = a f== b;
	fp_cc3 = un;
	CRFD = (fp_cc0 << 3) | (fp_cc1 << 2) | (fp_cc2 << 1) | un;
}

:ps_cmpu1 CRFD,fA,fB is OP=4 & CRFD & BITS_21_22=0 & fA & fB & ps1A & ps1B & XOP_1_10=64 & BIT_0=0
{
	local a:8 = ps1A;
	local b:8 = ps1B;
	local un:1 = nan(a) | nan(b);
	fp_cc0 = a f< b;
	fp_cc1 = a f> b;
	fp_cc2 = a f== b;
	fp_cc3 = un;
	CRFD = (fp_cc0 << 3) | (fp_cc1 << 2) | (fp_cc2 << 1) | un;
}

:ps_cmpo1 CRFD,fA,fB is OP=4 & CRFD & BITS_21_22=0 & fA & fB & ps1A & ps1B & XOP_1_10=96 & BIT_0=0
{
	local a:8 = ps1A;
	local b:8 = ps1B;
	local un:1 = nan(a) | nan(b);
	fp_cc0 = a f< b;
	fp_cc1 = a f> b;
	fp_cc2 = a f== b;
	fp_cc3 = un;
	CRFD = (fp_cc0 << 3) | (fp_cc1 << 2) | (fp_cc2 << 1) | un;
}

################################################################
# Locked-cache block zero
################################################################

:dcbz_l RA_OR_ZERO,B is OP=4 & BITS_21_25=0 & RA_OR_ZERO & B & XOP_1_10=1014 & BIT_0=0
{
	ea:$(REGISTER_SIZE) = RA_OR_ZERO + B;
	dataCacheBlockClearToZeroLocked(ea);
}
