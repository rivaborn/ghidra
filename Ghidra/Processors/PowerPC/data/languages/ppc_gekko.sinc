ps1B: is B_BITS=30 { export ps1_f30; }
ps1B: is B_BITS=31 { export ps1_f31; }

ps1C: is BITS_6_10=0 { export ps1_f0; }
ps1C: is BITS_6_10=1 { export ps1_f1; }
ps1C: is BITS_6_10=2 { export ps1_f2; }
ps1C: is BITS_6_10=3 { export ps1_f3; }
ps1C: is BITS_6_10=4 { export ps1_f4; }
ps1C: is BITS_6_10=5 { export ps1_f5; }
ps1C: is BITS_6_10=6 { export ps1_f6; }
ps1C: is BITS_6_10=7 { export ps1_f7; }
