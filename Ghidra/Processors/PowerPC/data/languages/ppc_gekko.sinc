ps1A: is A_BITS=27 { export ps1_f27; }
ps1A: is A_BITS=28 { export ps1_f28; }
ps1A: is A_BITS=29 { export ps1_f29; }
ps1A: is A_BITS=30 { export ps1_f30; }
ps1A: is A_BITS=31 { export ps1_f31; }

ps1B: is B_BITS=0 { export ps1_f0; }
ps1B: is B_BITS=1 { export ps1_f1; }
ps1B: is B_BITS=2 { export ps1_f2; }
ps1B: is B_BITS=3 { export ps1_f3; }
ps1B: is B_BITS=4 { export ps1_f4; }
ps1B: is B_BITS=5 { export ps1_f5; }
ps1B: is B_BITS=6 { export ps1_f6; }
