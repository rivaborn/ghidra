ps1A: is A_BITS=16 { export ps1_f16; }
ps1A: is A_BITS=17 { export ps1_f17; }
ps1A: is A_BITS=18 { export ps1_f18; }
ps1A: is A_BITS=19 { export ps1_f19; }
ps1A: is A_BITS=20 { export ps1_f20; }
ps1A: is A_BITS=21 { export ps1_f21; }
ps1A: is A_BITS=22 { export ps1_f22; }
ps1A: is A_BITS=23 { export ps1_f23; }
ps1A: is A_BITS=24 { export ps1_f24; }
