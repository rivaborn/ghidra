#
# IBM Gekko (GameCube), Broadway (Wii) and Espresso (Wii U) paired-single extension
# of the PowerPC 750CL. Included by ppc_common.sinc when GEKKO_PS is defined, before
# ppc_instructions.sinc (see ppc_32_gekko_be.slaspec).
#
# Register model
#   Each FPR holds two values, ps0 and ps1. ps0 is the ordinary FPR (f0..f31, a
#   double). ps1 is modelled as a second double, ps1_f0..ps1_f31, placed in the
#   otherwise unused low half of the VSX register that holds the FPR (offset of
#   fN + 8). Paired-single arithmetic computes in double precision and rounds each
#   result to single precision, the same way the stock fadds/fmuls do.
#   Single-precision loads and arithmetic (lfs, fadds, frsp, ...) write the result
#   into both halves (GEKKO_PS1_FILL below); double-precision instructions leave
#   ps1 alone.
#
# Quantization registers
#   GQR0..GQR7 are SPR 912..919 and HID2 is SPR 920 (named in ppc_32_gekko.pspec).
#   GQR layout (bit 0 = LSB): LD_SCALE 24..29, LD_TYPE 16..18, ST_SCALE 8..13,
#   ST_TYPE 0..2. Type 0 is float; 4 u8, 5 u16, 6 s8, 7 s16.
#   psq_l/psq_st test the type at run time: type 0 gives ordinary single-precision
#   loads and stores; any other type calls psqDequantize(ea, GQR) /
#   psqQuantize(ea, GQR, value) for each element (element size 1 or 2 bytes).
#   ppc_32_gekko.pspec tracks GQR0 = 0 (float), the value the SDK's OS init writes
#   and the one compiled code assumes, so the decompiler folds the test away for
#   qr0. Set GQR1..GQR7 with "Set Register Values" to fold the others.
#
# Not modelled: FPSCR exception bits (paired-single ops set FPRF from ps0 only),
# the estimate precision of ps_res / ps_rsqrte (computed exactly), denormal
# flushing, the locked-cache side of dcbz_l (a pcodeop like the stock dcbz).
define register offset=0x4008 size=8 [
	ps1_f0 _ ps1_f1 _ ps1_f2 _ ps1_f3 _ ps1_f4 _ ps1_f5 _ ps1_f6 _ ps1_f7 _ ps1_f8 _ ps1_f9 _ ps1_f10 _ ps1_f11 _ ps1_f12 _ ps1_f13 _ ps1_f14 _ ps1_f15 _
	ps1_f16 _ ps1_f17 _ ps1_f18 _ ps1_f19 _ ps1_f20 _ ps1_f21 _ ps1_f22 _ ps1_f23 _ ps1_f24 _ ps1_f25 _ ps1_f26 _ ps1_f27 _ ps1_f28 _ ps1_f29 _ ps1_f30 _ ps1_f31 ];

# ps1 half of the FPR named by each operand field (fD/fS, fA, fB, fC)
ps1D: is Dp=0 { export ps1_f0; }
ps1D: is Dp=1 { export ps1_f1; }
ps1D: is Dp=2 { export ps1_f2; }
ps1D: is Dp=3 { export ps1_f3; }
ps1D: is Dp=4 { export ps1_f4; }
ps1D: is Dp=5 { export ps1_f5; }
ps1D: is Dp=6 { export ps1_f6; }
ps1D: is Dp=7 { export ps1_f7; }
ps1D: is Dp=8 { export ps1_f8; }
ps1D: is Dp=9 { export ps1_f9; }
ps1D: is Dp=10 { export ps1_f10; }
ps1D: is Dp=11 { export ps1_f11; }
ps1D: is Dp=12 { export ps1_f12; }
ps1D: is Dp=13 { export ps1_f13; }
ps1D: is Dp=14 { export ps1_f14; }
ps1D: is Dp=15 { export ps1_f15; }
ps1D: is Dp=16 { export ps1_f16; }
ps1D: is Dp=17 { export ps1_f17; }
ps1D: is Dp=18 { export ps1_f18; }
ps1D: is Dp=19 { export ps1_f19; }
ps1D: is Dp=20 { export ps1_f20; }
ps1D: is Dp=21 { export ps1_f21; }
ps1D: is Dp=22 { export ps1_f22; }
ps1D: is Dp=23 { export ps1_f23; }
ps1D: is Dp=24 { export ps1_f24; }
ps1D: is Dp=25 { export ps1_f25; }
ps1D: is Dp=26 { export ps1_f26; }
ps1D: is Dp=27 { export ps1_f27; }
ps1D: is Dp=28 { export ps1_f28; }
ps1D: is Dp=29 { export ps1_f29; }
ps1D: is Dp=30 { export ps1_f30; }
ps1D: is Dp=31 { export ps1_f31; }

ps1A: is A_BITS=0 { export ps1_f0; }
ps1A: is A_BITS=1 { export ps1_f1; }
ps1A: is A_BITS=2 { export ps1_f2; }
ps1A: is A_BITS=3 { export ps1_f3; }
ps1A: is A_BITS=4 { export ps1_f4; }
ps1A: is A_BITS=5 { export ps1_f5; }
ps1A: is A_BITS=6 { export ps1_f6; }
