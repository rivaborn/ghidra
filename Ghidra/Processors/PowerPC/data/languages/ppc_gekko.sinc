ps1B: is B_BITS=19 { export ps1_f19; }
ps1B: is B_BITS=20 { export ps1_f20; }
ps1B: is B_BITS=21 { export ps1_f21; }
ps1B: is B_BITS=22 { export ps1_f22; }
ps1B: is B_BITS=23 { export ps1_f23; }
ps1B: is B_BITS=24 { export ps1_f24; }
ps1B: is B_BITS=25 { export ps1_f25; }
ps1B: is B_BITS=26 { export ps1_f26; }
ps1B: is B_BITS=27 { export ps1_f27; }
