ps1A: is A_BITS=8 { export ps1_f8; }
ps1A: is A_BITS=9 { export ps1_f9; }
ps1A: is A_BITS=10 { export ps1_f10; }
ps1A: is A_BITS=11 { export ps1_f11; }
