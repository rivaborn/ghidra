# SLA specification for the IBM Gekko (GameCube), Broadway (Wii) and Espresso (Wii U):
# 32-bit big endian PowerPC 750CL with paired singles. No AltiVec (its primary opcode 4
# is the paired-single opcode), no 4xx integer multiply-accumulate (also opcode 4).
# See ppc_gekko.sinc.

@define ENDIAN "big"

@define REGISTER_SIZE "4"

@define EATRUNC "ea"

@define CTR_OFFSET "32"

@define NoLegacyIntegerMultiplyAccumulate ""

@define GEKKO_PS ""

@include "ppc_common.sinc"
@include "g2.sinc"
