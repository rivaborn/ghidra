	local sw:4 = uFSw;
	local rx:4 = abs(sx);
	local ry:4 = abs(sy);
	local rz:4 = abs(sz);
	local rw:4 = abs(sw);
	build LOWERPART;
	if (u_dx == 0:1) goto <wx>; u_ftx = rx; <wx>
	if (u_dy == 0:1) goto <wy>; u_fty = ry; <wy>
	if (u_dz == 0:1) goto <wz>; u_ftz = rz; <wz>
