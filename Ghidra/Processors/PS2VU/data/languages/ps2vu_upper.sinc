:vclipw^UDEST^UFLAGS u_fs, u_ft^"w" LOWERPART
	is u_op4=0xF & u_sp=7 & u_bc=3 & u_zero=0 & UDEST & UFLAGS & u_dx & u_dy & u_dz & u_dw & LOWERPART & LFLOW & u_fs & uFSx & uFSy & uFSz & u_ft & uFTw
{
	local sx:4 = uFSx;
	local sy:4 = uFSy;
	local sz:4 = uFSz;
	local pw:4 = abs(uFTw);
	local nw:4 = f- pw;
	local j0:4 = zext(pw f< sx);
	local j1:4 = zext(sx f< nw);
	local j2:4 = zext(pw f< sy);
	local j3:4 = zext(sy f< nw);
	local j4:4 = zext(pw f< sz);
	local j5:4 = zext(sz f< nw);
	local judge:4 = j0 | (j1 << 1) | (j2 << 2) | (j3 << 3) | (j4 << 4) | (j5 << 5);
	local newclip:4 = ((clip_flag << 6) | judge) & 0xFFFFFF;
	build LOWERPART;
	clip_flag = newclip;
	build LFLOW;
}

