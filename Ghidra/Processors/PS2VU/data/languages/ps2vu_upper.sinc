#
# PlayStation 2 Vector Unit, micro mode: upper (FMAC) instructions.
#
# Every 64-bit LIW is one Ghidra instruction; the root constructors below are the upper
# instructions (so the upper mnemonic is the instruction mnemonic) and LOWERPART prints and
# executes the lower half (or LOI when the I bit is set). LFLOW holds the control flow of the
# lower half (branches, delay slots, E bit) so that it runs after the upper results are written.
#
# P-code order inside one LIW:
#   1. the upper sources are read into temporaries (the upper reads the pre-LIW state);
#   2. LOWERPART runs (it also reads the pre-LIW state of everything the upper writes);
#   3. the upper results are written, field by field, under the dest mask (an upper result
#      therefore wins when both halves write the same register);
#   4. LFLOW: branch / E-bit delay slot and transfer.
# The dest mask is tested with constant conditional branches (`if (u_dx == 0) goto ...`);
# the decompiler folds them away, so only the written fields remain.
#
# Encoding (upper word = bits 63..32 of the LIW, at address + 4):
#   I E M D T 00 dest(4) ft(5) fs(5) fd(5) op(6)
#   op 0x3C..0x3F selects the second table, index = fd * 4 + (op & 3).


:vadd^UBC^UDEST^UFLAGS u_fd, u_fs, uFTbc LOWERPART
	is u_op4=0 & UBC & u_zero=0 & UDEST & UFLAGS & u_dx & u_dy & u_dz & u_dw & LOWERPART & LFLOW & u_fd & u_fdx & u_fdy & u_fdz & u_fdw & u_fs & uFSx & uFSy & uFSz & uFSw & uFTbc
{
	local sx:4 = uFSx;
	local sy:4 = uFSy;
	local sz:4 = uFSz;
	local sw:4 = uFSw;
	local t:4 = uFTbc;
	local rx:4 = sx f+ t;
	local ry:4 = sy f+ t;
	local rz:4 = sz f+ t;
	local rw:4 = sw f+ t;
	build LOWERPART;
	if (u_dx == 0:1) goto <wx>; u_fdx = rx; <wx>
	if (u_dy == 0:1) goto <wy>; u_fdy = ry; <wy>
	if (u_dz == 0:1) goto <wz>; u_fdz = rz; <wz>
	if (u_dw == 0:1) goto <ww>; u_fdw = rw; <ww>
	build LFLOW;
}

