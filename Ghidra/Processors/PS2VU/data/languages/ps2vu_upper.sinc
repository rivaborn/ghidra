	is u_op4=0xF & u_sp=7 & u_bc=1 & u_zero=0 & UDEST & UFLAGS & u_dx & u_dy & u_dz & u_dw & LOWERPART & LFLOW & u_ft & u_ftx & u_fty & u_ftz & u_ftw & u_fs & uFSx & uFSy & uFSz & uFSw
