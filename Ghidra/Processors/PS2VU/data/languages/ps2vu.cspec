<!-- Microprograms have no ABI: a microprogram (and a BAL subroutine) is treated as
     void f(void) working on the global register file. BAL/JALR put the return address
     (in 8-byte LIW units) in a vi register, by convention vi15; JR vi15 returns.
     SP is a placeholder register (there is no stack). -->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="4" />
     <default_alignment value="1" />
     <default_pointer_alignment value="4" />
     <pointer_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="8" />
          <entry size="16" alignment="16" />
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="micro"/>
    <range space="vumem"/>
  </global>
  <stackpointer register="SP" space="vumem"/>
  <returnaddress>
    <register name="vi15"/>
  </returnaddress>
  <default_proto>
    <prototype name="__vumicro" extrapop="0" stackshift="0">
      <input>
      </input>
      <output>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
