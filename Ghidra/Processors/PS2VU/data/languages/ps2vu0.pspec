<!-- VU0 in micro mode: 4 KB micro memory (space "micro", loaded by the importer) and
     4 KB data memory (space "vumem", created here, uninitialized). -->
<processor_spec>
  <programcounter register="PC"/>
  <default_memory_blocks>
    <memory_block name="vumem" start_address="vumem:0x0" length="0x1000" initialized="false"/>
  </default_memory_blocks>
</processor_spec>
