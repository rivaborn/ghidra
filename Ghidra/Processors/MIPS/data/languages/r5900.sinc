# Halfword multiply / multiply-add / divide: rd, LO and HI are all written (pcodeop per output)
define pcodeop pmaddh;
define pcodeop pmaddh_lo;
define pcodeop pmaddh_hi;
:pmaddh RDQ, RSQ, RTQ       is prime=0x1C & fct=0x09 & ee_mmiop=0x10 & RDQ & RSQ & RTQ {
    local olo:16 = lo_qw;
    local ohi:16 = hi_qw;
    local res:16 = pmaddh(RSQ, RTQ, olo, ohi);
    lo_qw = pmaddh_lo(RSQ, RTQ, olo, ohi);
    hi_qw = pmaddh_hi(RSQ, RTQ, olo, ohi);
    RDQ = res;
}
define pcodeop phmadh;
define pcodeop phmadh_lo;
define pcodeop phmadh_hi;
:phmadh RDQ, RSQ, RTQ       is prime=0x1C & fct=0x09 & ee_mmiop=0x11 & RDQ & RSQ & RTQ {
    local res:16 = phmadh(RSQ, RTQ);
    lo_qw = phmadh_lo(RSQ, RTQ);
    hi_qw = phmadh_hi(RSQ, RTQ);
    RDQ = res;
}
define pcodeop pmsubh;
define pcodeop pmsubh_lo;
define pcodeop pmsubh_hi;
:pmsubh RDQ, RSQ, RTQ       is prime=0x1C & fct=0x09 & ee_mmiop=0x14 & RDQ & RSQ & RTQ {
    local olo:16 = lo_qw;
    local ohi:16 = hi_qw;
    local res:16 = pmsubh(RSQ, RTQ, olo, ohi);
    lo_qw = pmsubh_lo(RSQ, RTQ, olo, ohi);
    hi_qw = pmsubh_hi(RSQ, RTQ, olo, ohi);
    RDQ = res;
}
define pcodeop phmsbh;
define pcodeop phmsbh_lo;
define pcodeop phmsbh_hi;
:phmsbh RDQ, RSQ, RTQ       is prime=0x1C & fct=0x09 & ee_mmiop=0x15 & RDQ & RSQ & RTQ {
    local res:16 = phmsbh(RSQ, RTQ);
    lo_qw = phmsbh_lo(RSQ, RTQ);
    hi_qw = phmsbh_hi(RSQ, RTQ);
    RDQ = res;
}
define pcodeop pmulth;
define pcodeop pmulth_lo;
define pcodeop pmulth_hi;
:pmulth RDQ, RSQ, RTQ       is prime=0x1C & fct=0x09 & ee_mmiop=0x1C & RDQ & RSQ & RTQ {
    local res:16 = pmulth(RSQ, RTQ);
    lo_qw = pmulth_lo(RSQ, RTQ);
    hi_qw = pmulth_hi(RSQ, RTQ);
    RDQ = res;
}
define pcodeop pdivbw_quotient;
define pcodeop pdivbw_remainder;
:pdivbw RSQ, RTQ            is prime=0x1C & fct=0x09 & ee_mmiop=0x1D & rd=0 & RSQ & RTQ {
    lo_qw = pdivbw_quotient(RSQ, RTQ);
    hi_qw = pdivbw_remainder(RSQ, RTQ);
}

# ---------------------------------------------------------------------------------------
# COP2 = VU0 macro instructions (COP2 with bit 25 set): 0100 101d dddd tttt tsss sddd ddff ffff
# dest = xyzw write mask (bits 24..21), ft/fs/fd = vf registers, bc = broadcast field (bits 1..0).
# Functions 0x3C-0x3F select the second table, indexed by (bits 10..6) * 4 + (bits 1..0).
# Semantics are pcodeop calls; the dest mask is passed as the first argument and the old
# destination value is passed in so that unwritten fields are visibly preserved.

EEDEST: ""            is ee_dest=0 { export 0:1; }
EEDEST: ".w"          is ee_dest=1 { export 1:1; }
EEDEST: ".z"          is ee_dest=2 { export 2:1; }
EEDEST: ".zw"         is ee_dest=3 { export 3:1; }
EEDEST: ".y"          is ee_dest=4 { export 4:1; }
EEDEST: ".yw"         is ee_dest=5 { export 5:1; }
EEDEST: ".yz"         is ee_dest=6 { export 6:1; }
EEDEST: ".yzw"        is ee_dest=7 { export 7:1; }
EEDEST: ".x"          is ee_dest=8 { export 8:1; }
EEDEST: ".xw"         is ee_dest=9 { export 9:1; }
EEDEST: ".xz"         is ee_dest=10 { export 10:1; }
EEDEST: ".xzw"        is ee_dest=11 { export 11:1; }
EEDEST: ".xy"         is ee_dest=12 { export 12:1; }
EEDEST: ".xyw"        is ee_dest=13 { export 13:1; }
EEDEST: ".xyz"        is ee_dest=14 { export 14:1; }
EEDEST: ".xyzw"       is ee_dest=15 { export 15:1; }

EEBC: "x"             is ee_bc=0 { export 0:1; }
EEBC: "y"             is ee_bc=1 { export 1:1; }
EEBC: "z"             is ee_bc=2 { export 2:1; }
EEBC: "w"             is ee_bc=3 { export 3:1; }

EEFTBC: ee_vft^"x"          is ee_vft & ee_bc=0 { local t:4 = ee_vft:4; export t; }
EEFTBC: ee_vft^"y"          is ee_vft & ee_bc=1 { local t:4 = ee_vft(4); export t; }
EEFTBC: ee_vft^"z"          is ee_vft & ee_bc=2 { local t:4 = ee_vft(8); export t; }
EEFTBC: ee_vft^"w"          is ee_vft & ee_bc=3 { local t:4 = ee_vft(12); export t; }
EEFSF: ee_vfs^".x"          is ee_vfs & ee_fsf=0 { local t:4 = ee_vfs:4; export t; }
EEFSF: ee_vfs^".y"          is ee_vfs & ee_fsf=1 { local t:4 = ee_vfs(4); export t; }
EEFSF: ee_vfs^".z"          is ee_vfs & ee_fsf=2 { local t:4 = ee_vfs(8); export t; }
EEFSF: ee_vfs^".w"          is ee_vfs & ee_fsf=3 { local t:4 = ee_vfs(12); export t; }
EEFTF: ee_vft^".x"          is ee_vft & ee_ftf=0 { local t:4 = ee_vft:4; export t; }
EEFTF: ee_vft^".y"          is ee_vft & ee_ftf=1 { local t:4 = ee_vft(4); export t; }
EEFTF: ee_vft^".z"          is ee_vft & ee_ftf=2 { local t:4 = ee_vft(8); export t; }
EEFTF: ee_vft^".w"          is ee_vft & ee_ftf=3 { local t:4 = ee_vft(12); export t; }

EECALLMS: addr  is ee_imm15 [ addr = ee_imm15 << 3; ] { export *[const]:4 addr; }

define pcodeop vaddbc;
:vadd^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC        is prime=0x12 & bit25=1 & ee_vfunc2=0 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vaddbc(EEDEST, ee_vfd, ee_vfs, EEFTBC); }
define pcodeop vsubbc;
:vsub^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC        is prime=0x12 & bit25=1 & ee_vfunc2=1 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vsubbc(EEDEST, ee_vfd, ee_vfs, EEFTBC); }
define pcodeop vmaddbc;
:vmadd^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC       is prime=0x12 & bit25=1 & ee_vfunc2=2 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vmaddbc(EEDEST, ee_vfd, vu0_acc, ee_vfs, EEFTBC); }
define pcodeop vmsubbc;
:vmsub^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC       is prime=0x12 & bit25=1 & ee_vfunc2=3 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vmsubbc(EEDEST, ee_vfd, vu0_acc, ee_vfs, EEFTBC); }
define pcodeop vmaxbc;
:vmax^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC        is prime=0x12 & bit25=1 & ee_vfunc2=4 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vmaxbc(EEDEST, ee_vfd, ee_vfs, EEFTBC); }
define pcodeop vminibc;
:vmini^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC       is prime=0x12 & bit25=1 & ee_vfunc2=5 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vminibc(EEDEST, ee_vfd, ee_vfs, EEFTBC); }
define pcodeop vmulbc;
:vmul^EEBC^EEDEST ee_vfd, ee_vfs, EEFTBC        is prime=0x12 & bit25=1 & ee_vfunc2=6 & EEBC & EEDEST & ee_vfd & ee_vfs & EEFTBC { ee_vfd = vmulbc(EEDEST, ee_vfd, ee_vfs, EEFTBC); }
define pcodeop vmulq;
:vmulq^EEDEST ee_vfd, ee_vfs, "Q"               is prime=0x12 & bit25=1 & ee_vfunc=0x1C & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmulq(EEDEST, ee_vfd, ee_vfs, vu0_q); }
define pcodeop vmaxi;
:vmaxi^EEDEST ee_vfd, ee_vfs, "I"               is prime=0x12 & bit25=1 & ee_vfunc=0x1D & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmaxi(EEDEST, ee_vfd, ee_vfs, vu0_i); }
define pcodeop vmuli;
:vmuli^EEDEST ee_vfd, ee_vfs, "I"               is prime=0x12 & bit25=1 & ee_vfunc=0x1E & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmuli(EEDEST, ee_vfd, ee_vfs, vu0_i); }
define pcodeop vminii;
:vminii^EEDEST ee_vfd, ee_vfs, "I"              is prime=0x12 & bit25=1 & ee_vfunc=0x1F & EEDEST & ee_vfd & ee_vfs { ee_vfd = vminii(EEDEST, ee_vfd, ee_vfs, vu0_i); }
define pcodeop vaddq;
:vaddq^EEDEST ee_vfd, ee_vfs, "Q"               is prime=0x12 & bit25=1 & ee_vfunc=0x20 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vaddq(EEDEST, ee_vfd, ee_vfs, vu0_q); }
define pcodeop vmaddq;
:vmaddq^EEDEST ee_vfd, ee_vfs, "Q"              is prime=0x12 & bit25=1 & ee_vfunc=0x21 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmaddq(EEDEST, ee_vfd, vu0_acc, ee_vfs, vu0_q); }
define pcodeop vaddi;
:vaddi^EEDEST ee_vfd, ee_vfs, "I"               is prime=0x12 & bit25=1 & ee_vfunc=0x22 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vaddi(EEDEST, ee_vfd, ee_vfs, vu0_i); }
define pcodeop vmaddi;
:vmaddi^EEDEST ee_vfd, ee_vfs, "I"              is prime=0x12 & bit25=1 & ee_vfunc=0x23 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmaddi(EEDEST, ee_vfd, vu0_acc, ee_vfs, vu0_i); }
define pcodeop vsubq;
:vsubq^EEDEST ee_vfd, ee_vfs, "Q"               is prime=0x12 & bit25=1 & ee_vfunc=0x24 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vsubq(EEDEST, ee_vfd, ee_vfs, vu0_q); }
define pcodeop vmsubq;
:vmsubq^EEDEST ee_vfd, ee_vfs, "Q"              is prime=0x12 & bit25=1 & ee_vfunc=0x25 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmsubq(EEDEST, ee_vfd, vu0_acc, ee_vfs, vu0_q); }
define pcodeop vsubi;
:vsubi^EEDEST ee_vfd, ee_vfs, "I"               is prime=0x12 & bit25=1 & ee_vfunc=0x26 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vsubi(EEDEST, ee_vfd, ee_vfs, vu0_i); }
define pcodeop vmsubi;
:vmsubi^EEDEST ee_vfd, ee_vfs, "I"              is prime=0x12 & bit25=1 & ee_vfunc=0x27 & EEDEST & ee_vfd & ee_vfs { ee_vfd = vmsubi(EEDEST, ee_vfd, vu0_acc, ee_vfs, vu0_i); }
define pcodeop vadd;
:vadd^EEDEST ee_vfd, ee_vfs, ee_vft             is prime=0x12 & bit25=1 & ee_vfunc=0x28 & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vadd(EEDEST, ee_vfd, ee_vfs, ee_vft); }
define pcodeop vmadd;
:vmadd^EEDEST ee_vfd, ee_vfs, ee_vft            is prime=0x12 & bit25=1 & ee_vfunc=0x29 & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vmadd(EEDEST, ee_vfd, vu0_acc, ee_vfs, ee_vft); }
define pcodeop vmul;
:vmul^EEDEST ee_vfd, ee_vfs, ee_vft             is prime=0x12 & bit25=1 & ee_vfunc=0x2A & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vmul(EEDEST, ee_vfd, ee_vfs, ee_vft); }
