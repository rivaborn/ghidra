define pcodeop vsub;
:vsub^EEDEST ee_vfd, ee_vfs, ee_vft             is prime=0x12 & bit25=1 & ee_vfunc=0x2C & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vsub(EEDEST, ee_vfd, ee_vfs, ee_vft); }
