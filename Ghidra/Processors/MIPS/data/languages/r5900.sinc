:vmsub^EEDEST ee_vfd, ee_vfs, ee_vft            is prime=0x12 & bit25=1 & ee_vfunc=0x2D & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vmsub(EEDEST, ee_vfd, vu0_acc, ee_vfs, ee_vft); }
define pcodeop vopmsub;
:vopmsub^EEDEST ee_vfd, ee_vfs, ee_vft          is prime=0x12 & bit25=1 & ee_vfunc=0x2E & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vopmsub(EEDEST, ee_vfd, vu0_acc, ee_vfs, ee_vft); }
define pcodeop vmini;
:vmini^EEDEST ee_vfd, ee_vfs, ee_vft            is prime=0x12 & bit25=1 & ee_vfunc=0x2F & EEDEST & ee_vfd & ee_vfs & ee_vft { ee_vfd = vmini(EEDEST, ee_vfd, ee_vfs, ee_vft); }
:viadd ee_vid, ee_vis, ee_vit                   is prime=0x12 & bit25=1 & ee_vfunc=0x30 & ee_vid & ee_vis & ee_vit { ee_vid = ee_vis + ee_vit; }
:visub ee_vid, ee_vis, ee_vit                   is prime=0x12 & bit25=1 & ee_vfunc=0x31 & ee_vid & ee_vis & ee_vit { ee_vid = ee_vis - ee_vit; }
:viaddi ee_vit, ee_vis, ee_imm5                 is prime=0x12 & bit25=1 & ee_vfunc=0x32 & ee_vit & ee_vis & ee_imm5 { ee_vit = ee_vis + ee_imm5; }
:viand ee_vid, ee_vis, ee_vit                   is prime=0x12 & bit25=1 & ee_vfunc=0x34 & ee_vid & ee_vis & ee_vit { ee_vid = ee_vis & ee_vit; }
