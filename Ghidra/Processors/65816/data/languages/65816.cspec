<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <data_organization>
    <pointer_size value="3"/>
    <short_size value="2"/>
    <integer_size value="2"/>
    <long_size value="4"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <!-- One convention for JSR/RTS and JSL/RTL functions. SP is modelled as
         S + 1 (see the .slaspec), so at function entry the return address
         is at SP+0. extrapop matches RTS; the JSL p-code compensates for the
         extra bank byte an RTL pops. Arguments/results in C (A), X, Y. -->
    <prototype name="__asmcall" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="2">
          <register name="C"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="X"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="Y"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="2">
          <register name="C"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
        <register name="D"/>
        <register name="DBR"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
