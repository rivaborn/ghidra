<?xml version="1.0" encoding="UTF-8"?>

<!-- Calling conventions for the Sharp LR35902 / SM83 (Game Boy, Game Boy Color).

     Game Boy software is mostly hand-written assembly with no fixed ABI. The
     default prototype takes register arguments (A, then BC, DE, HL, then the
     stack) and returns an 8-bit value in A or a 16-bit value in HL. CALL and RST
     push a 2-byte return address, which RET pops (extrapop/stackshift = 2). -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0" />
    <machine_alignment value="1" />
    <default_alignment value="1" />
    <default_pointer_alignment value="1" />
    <pointer_size value="2" />
    <char_type signed="false" />
    <char_size value="1" />
    <short_size value="2" />
    <integer_size value="2" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="4" />
    <long_double_size value="4" />
    <size_alignment_map>
      <entry size="1" alignment="1" />
      <entry size="2" alignment="1" />
      <entry size="4" alignment="1" />
      <entry size="8" alignment="1" />
    </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__asmcall" extrapop="2" stackshift="2" strategy="register">
      <input>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="BC"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="DE"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="HL"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="A"/>
        </pentry>
        <pentry minsize="2" maxsize="2">
          <register name="HL"/>
        </pentry>
      </output>
      <unaffected>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
  <!-- 16-bit result in HL first (for routines that return a pointer or word) -->
  <prototype name="__asmcall_hl" extrapop="2" stackshift="2" strategy="register">
    <input>
      <pentry minsize="1" maxsize="1">
        <register name="A"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="BC"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="DE"/>
      </pentry>
      <pentry minsize="1" maxsize="2">
        <register name="HL"/>
      </pentry>
      <pentry minsize="1" maxsize="500" align="2">
        <addr offset="2" space="stack"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="2">
        <register name="HL"/>
      </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
    </unaffected>
  </prototype>
</compiler_spec>
